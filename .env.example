# 复制为 .env 并填写真实值（#8 §3.3；POSTGRES_PASSWORD 与 JWT_SECRET 生产须为强随机串）

# 应用
APP_ENV=production
APP_PORT=8080
DATABASE_URL=postgres://afuser:afpass@postgres:5432/aiforum?sslmode=disable

# PostgreSQL
POSTGRES_USER=afuser
POSTGRES_PASSWORD=afpass
POSTGRES_DB=aiforum

# JWT / 加密
JWT_SECRET=change-me-in-production

# 图片上传（#12：生产 /opt/ai-forum/uploads 由 nginx 托管；以下为默认值，可省略）
UPLOADS_DIR=/opt/ai-forum/uploads
UPLOAD_MAX_BYTES=5242880
